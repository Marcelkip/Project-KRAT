generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication
model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
}

// Reports generated by KRAT
model Report {
  id    Int    @id @default(autoincrement())
  title String
  dates Json

  // Relations
  tickets           Ticket[]
  chartDescriptions ChartDescriptions[]
  trendSummary      ReportTrendsSummary?

  createdAt DateTime @default(now())

  // pending | review_required | completed | failed
  status ReportStatusTypes

  @@index([createdAt])
}

enum ReportStatusTypes {
  pending
  review_required
  completed
  failed
}

// AI-generated descriptions for charts
model ChartDescriptions {
  id              Int     @id @default(autoincrement())
  chartType       String
  description     String
  trendType       String?
  severity        String?
  possibleActions Json?
  changeReason    String?

  reportId Int?
  report   Report? @relation(fields: [reportId], references: [id])

  @@unique([reportId, chartType])
}

// AI-generated trend summary
model ReportTrendsSummary {
  id                 Int     @id @default(autoincrement())
  summary            String
  highlights         Json?
  risks              Json?
  recommendedActions Json?

  reportId Int?    @unique
  report   Report? @relation(fields: [reportId], references: [id])
}

// TOPdesk tickets
model Ticket {
  id        Int    @id @default(autoincrement())
  topdeskId String

  // TOPdesk information
  category    String
  subCategory String?

  // AI-generated fields
  systems            Json   @default("[]")
  issue_types        Json   @default("[]")
  briefDescriptionAI String?

  // Caller information
  callerLocation   String?
  callerDepartment String?
  callerRole       String?

  // Operator information
  operatorName  String?
  operatorGroup String?

  // Ticket status
  closed     Boolean
  closedDate DateTime?

  completed     Boolean
  completedDate DateTime?

  responded     Boolean
  respondedDate DateTime?

  // Dates
  creationDate DateTime
  callDate     DateTime?

  // Ticket information
  status    String?
  entryType String
  impact    String?
  urgency   String?
  priority  String?

  briefDescription String?

  latestUpdate   DateTime?
  latestUpdateBy String?

  // Relation to report
  reportId Int?
  report   Report? @relation(fields: [reportId], references: [id])

  // Indexes for faster queries
  @@index([category])
  @@index([subCategory])
  @@index([creationDate])
  @@index([closed])
  @@index([completed])
  @@index([status])
  @@index([entryType])
  @@index([priority])
  @@index([callerDepartment])
}
